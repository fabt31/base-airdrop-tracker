# Neynar API (gratuit sur neynar.com) — pour lire les données Farcaster
NEYNAR_API_KEY=your_neynar_api_key_here

# Basescan API (gratuit sur basescan.org/myapikey) — pour lire l'activité on-chain
BASESCAN_API_KEY=your_basescan_api_key_here

# Talent Protocol API (gratuit sur talentprotocol.com/developers) — Builder Score
TALENT_API_KEY=your_talent_api_key_here

# URL publique de l'app (pour les meta tags Farcaster)
NEXT_PUBLIC_URL=https://your-app.vercel.app
